#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&sk { /delete-property/ ignore-modifiers; };

/ {
    combos {
        compatible = "zmk,combos";

        ClearAllProfiles {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <24 12 36>;
        };

        P0-select {
            bindings = <&bt BT_SEL 0>;
            key-positions = <12 24 6>;
        };

        P1-select {
            bindings = <&bt BT_SEL 1>;
            key-positions = <12 24 7>;
        };

        P2-select {
            bindings = <&bt BT_SEL 2>;
            key-positions = <12 24 8>;
        };

        P3-select {
            bindings = <&bt BT_SEL 3>;
            key-positions = <12 24 9>;
        };

        P4-select {
            bindings = <&bt BT_SEL 4>;
            key-positions = <12 24 10>;
        };

        P0-disconnect {
            bindings = <&bt BT_DISC 0>;
            key-positions = <12 24 1>;
        };

        P1-disconnect {
            bindings = <&bt BT_DISC 1>;
            key-positions = <24 12 2>;
        };

        P2-disconnect {
            bindings = <&bt BT_DISC 2>;
            key-positions = <24 12 3>;
        };

        P3-disconnect {
            bindings = <&bt BT_DISC 3>;
            key-positions = <12 24 4>;
        };

        P4-disconnect {
            bindings = <&bt BT_DISC 4>;
            key-positions = <24 12 5>;
        };

        BT-Next {
            bindings = <&bt BT_NXT>;
            key-positions = <12 24 35>;
        };

        BT-Previous {
            bindings = <&bt BT_PRV>;
            key-positions = <24 12 11>;
        };
    };

    macros {
        shift: shift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;

            label = "SHIFT";
        };

        as: as {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;

            label = "AS";
        };
    };

    behaviors {
        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            bindings = <&shift>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
        };

        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT_HAND";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <301>;
            hold-trigger-key-positions = <39 40 41 35 34 22 23 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT_HAND";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <301>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE  &kp Q  &kp C                &kp O                &kp P                &kp W              &kp J        &kp M             &kp D                 &kp EXCLAMATION       &kp Y  &none
&none       &kp A  &hml LEFT_COMMAND S  &hml LEFT_CONTROL E  &hml LEFT_ALT N      &kp F              &kp L        &hmr RIGHT_ALT R  &hmr RIGHT_CONTROL T  &hmr RIGHT_COMMAND I  &kp I  &none
&none       &kp Z  &kp X                &kp QUESTION         &kp V                &kp B              &kp DOT      &kp H             &kp G                 &kp COMMA             &kp K  &none
                                        &none                &hml TAB LEFT_SHIFT  &lt 1 BACKSPACE    &lt 1 SPACE  &lt 2 RETURN      &none
            >;
        };

        nav {
            bindings = <
&none  &kp TAB   &kp HOME           &kp UP      &kp END          &kp PG_UP      &kp FSLH   &kp N7  &kp N8  &kp N9  &none    &none
&none  &kp CAPS  &kp LEFT           &kp DOWN    &kp RIGHT        &kp PG_DN      &kp MINUS  &kp N4  &kp N5  &kp N6  &kp N0   &none
&none  &none     &kp C_VOLUME_DOWN  &kp K_MUTE  &kp C_VOLUME_UP  &kp LS(TAB)    &kp COMMA  &kp N1  &kp N2  &kp N3  &kp DOT  &none
                                    &trans      &trans           &trans         &trans     &trans  &trans
            >;
        };

        AltGr {
            bindings = <
&none  &kp CARET  &kp LT    &kp GREATER_THAN  &kp DLLR   &kp PERCENT    &kp AT    &kp AMPS  &kp STAR   &kp SQT    &kp GRAVE     &none
&none  &kp LBRC   &kp LPAR  &kp RPAR          &kp RBRC   &kp EQUAL      &kp BSLH  &kp PLUS  &kp MINUS  &kp FSLH   &kp DQT       &none
&none  &kp TILDE  &kp LBKT  &kp RBKT          &kp UNDER  &kp POUND      &kp PIPE  &kp EXCL  &kp SEMI   &kp COLON  &kp QUESTION  &none
                            &trans            &trans     &trans         &trans    &trans    &trans
            >;
        };
    };
};
